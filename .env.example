# Feature flags are local, non-authoritative demo inputs: they can hide a
# feature route but never grant roles, rows, or access, and the app makes no
# remote flag-service request. See README.md "Feature flags".
# Explicit true/false override. Leave empty to use the percentage rollout.
VITE_FEATURE_PRODUCTION_REQUIREMENTS=
# Percentage from 0 through 100. Assignment uses a persistent anonymous cohort.
VITE_FEATURE_PRODUCTION_REQUIREMENTS_ROLLOUT=100

# debug, info, warn, or error
VITE_LOG_LEVEL=

# Browser performance metrics. The endpoint must accept anonymous JSON POSTs.
# Production endpoints must be HTTPS on a host listed in
# APPROVED_TELEMETRY_HOSTS (src/lib/telemetry/config.ts); anything else fails
# closed to local-only. Plain HTTP is accepted only for loopback dev/test.
VITE_METRICS_ENDPOINT=
# Fraction of page loads to measure, from 0 through 1. Defaults to 1.
VITE_METRICS_SAMPLE_RATE=1
# Stable labels used to separate deployments and releases in dashboards.
VITE_DEPLOYMENT_ENV=development
VITE_RELEASE=

# Telemetry envelopes (logs, metrics, events, traces, errors, alerts, health).
# Same endpoint policy as above. Every envelope passes a registered field
# allowlist before it can be queued; there is no alert webhook transport.
VITE_TELEMETRY_ENDPOINT=
# Operator dashboard link stamped on telemetry batches (metadata only).
VITE_TELEMETRY_DASHBOARD_URL=
# Master switch: off means zero requests, beacons, or script loads.
VITE_FLAG_TELEMETRY_ENABLED=
# Product analytics opt-in, off by default; requires the master switch too.
VITE_FLAG_ANALYTICS_ENABLED=
# Optional GA4 measurement ID; inert unless both switches above are on.
VITE_GA_MEASUREMENT_ID=
