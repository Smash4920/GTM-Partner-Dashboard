# Explicit true/false override. Leave empty to use the percentage rollout.
VITE_FEATURE_PRODUCTION_REQUIREMENTS=
# Percentage from 0 through 100. Assignment uses a persistent anonymous cohort.
VITE_FEATURE_PRODUCTION_REQUIREMENTS_ROLLOUT=100

# debug, info, warn, or error
VITE_LOG_LEVEL=

# Browser performance metrics. The endpoint must accept anonymous JSON POSTs.
VITE_METRICS_ENDPOINT=
# Fraction of page loads to measure, from 0 through 1. Defaults to 1.
VITE_METRICS_SAMPLE_RATE=1
# Stable labels used to separate deployments and releases in dashboards.
VITE_DEPLOYMENT_ENV=development
VITE_RELEASE=
